# Serves the built client and proxies /api to the server (#116).
# ${API_UPSTREAM} is filled in from the environment when the container starts
# (client/Dockerfile). nginx's own variables, such as $uri, are left alone
# because they aren't set in the environment.

# Keep the protocol the browser used when another proxy is in front (Render
# terminates TLS, #117), else use this connection's. The server only sets its
# secure session cookie when it sees https here (server/src/middleware/session.ts).
map $http_x_forwarded_proto $forwarded_proto {
    default $http_x_forwarded_proto;
    ""      $scheme;
}

server {
    listen 8080;
    server_name _;

    # Don't advertise nginx's version (threat model S4).
    server_tokens off;

    root /usr/share/nginx/html;
    index index.html;

    location /api/ {
        proxy_pass ${API_UPSTREAM};
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $forwarded_proto;
    }

    # Vite's hashed bundles never change under the same name.
    location /assets/ {
        add_header Cache-Control "public, max-age=31536000, immutable";
        try_files $uri =404;
    }

    # Client-side routes (/history, /expenses/:id, /join/:token) all load the
    # app, which then routes in the browser. index.html itself is never cached,
    # so a deploy is picked up on the next load.
    location / {
        add_header Cache-Control "no-cache";
        try_files $uri $uri/ /index.html;
    }
}
